# ─────────────────────────────────────────────────────────────────────────────
# JARVIS Conversation Service — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# Azure Cosmos DB Configuration
# Provide your Azure Cosmos DB account endpoint and primary key below:
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=jarvis-conversations
COSMOS_CONVERSATIONS_CONTAINER=conversations
COSMOS_MESSAGES_CONTAINER=messages

# Local fallback storage directory (used seamlessly when Cosmos DB credentials are not set)
FALLBACK_STORAGE_DIR=.data
